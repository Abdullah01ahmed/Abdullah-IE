{
  "name": "twin-rivers-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Twin Rivers: Arena — an original 5v5 first-person arena shooter set across Iraqi-inspired maps.",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run typecheck",
    "dev:server": "npm run dev -w @tra/server --",
    "dev:client": "npm run dev -w @tra/client",
    "dev:desktop": "npm run dev -w @tra/desktop",
    "build:shared": "npm run typecheck -w @tra/shared",
    "build:client": "npm run build -w @tra/client",
    "build:server": "npm run build -w @tra/server",
    "build:desktop": "npm run build -w @tra/desktop",
    "build": "npm run build:client && npm run build:server && npm run build:desktop",
    "dist:win": "npm run build && npm run dist:win -w @tra/desktop",
    "dist:dir": "npm run build && npm run dist:dir -w @tra/desktop",
    "server": "node packages/server/dist/server.cjs",
    "e2e": "vitest run --project e2e"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
