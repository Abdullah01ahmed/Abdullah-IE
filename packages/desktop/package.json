{
  "name": "@tra/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Twin Rivers: Arena — Electron desktop shell, embedded host server launcher, and Windows installer build.",
  "main": "dist/main.cjs",
  "author": "Twin Rivers: Arena contributors",
  "homepage": "https://github.com/Abdullah01ahmed/Abdullah-IE",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/main.cjs",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:icon": "node scripts/make-icon.mjs",
    "verify:icon": "node scripts/verify-icon.mjs",
    "build:assets": "node scripts/make-icon.mjs && node scripts/prepare-assets.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:assets",
    "dev": "npm run build:main && npm run build:preload && cross-env-shell TRA_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start": "electron .",
    "dist:win": "node scripts/dist.mjs --win nsis --x64 --publish never",
    "dist:dir": "node scripts/dist.mjs --dir --win --x64 --publish never"
  },
  "devDependencies": {
    "@tra/shared": "0.1.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
